{
  "schemaVersion": 1,
  "id": "luxvisuals",
  "version": "${version}",
  "name": "LuxVisuals",
  "description": "Client-side visuals, cosmetics and HUD for Minecraft 1.21.11.",
  "authors": ["MONIX"],
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "code.miaware.MiaWare",
      "dev.luxvisuals.fix.LuxPlus",
      "dev.luxvisuals.menu.LuxBridge"
    ]
  },
  "mixins": [ "luxvisuals.mixins.json" ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "recommends": { "sodium": "*", "ias": "*" }
}
