{
  "schemaVersion": 1,
  "id": "luxvisuals",
  "version": "3.0",
  "name": "LuxVisuals",
  "description": "Client-side visuals, cosmetics and HUD for Minecraft 1.21.4. Works on PC and mobile.",
  "authors": [
    "MONIX"
  ],
  "license": "CC0-1.0",
  "icon": "assets/miaware/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "code.miaware.MiaWare",
      "dev.luxvisuals.fix.LuxPlus",
      "dev.luxvisuals.menu.LuxBridge"
    ]
  },
  "mixins": [
    "miaware.mixins.json",
    "luxvisuals.customsword.mixins.json",
    "phantom.mixins.json",
    "luxbridge.mixins.json"
  ],
  "accessWidener": "luxphantom.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.5",
    "minecraft": "~1.21.4",
    "java": ">=21",
    "fabric-api": "*"
  },
  "jars": [
    {
      "file": "META-INF/jars/IAS-9.0.6+1.21.4-fabric.jar"
    },
    {
      "file": "META-INF/jars/mixinextras-fabric-0.5.0-beta.3.jar"
    },
    {
      "file": "META-INF/jars/sodium-mc1.21.4-0.6.13-fabric.jar"
    },
    {
      "file": "META-INF/jars/media-player-info-0.1.0.jar"
    }
  ]
}